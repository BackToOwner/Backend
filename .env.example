PORT=5000
NODE_ENV=development

# SQLite file location (created automatically on first run)
DB_PATH=./data/admin.sqlite

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default admin account created by `npm run seed`
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=admin@backtoowner.com
ADMIN_SEED_PASSWORD=Admin@12345

# Comma-separated list of allowed origins for CORS (the Vite dev server, etc.)
CORS_ORIGIN=http://localhost:5173
